# Copy this file to `.env` and fill in real values. `.env` is gitignored.

ENV=dev

# --- Postgres (Neon) -------------------------------------------------------
# From the Neon dashboard, "Connection string". IMPORTANT: change the prefix
# from `postgresql://` to `postgresql+psycopg://` so SQLAlchemy uses psycopg 3.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/outfit_picker?sslmode=require

# --- Redis (Upstash) -------------------------------------------------------
# Not used until Phase 3. Upstash gives you a rediss:// URL (note the two s's).
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# --- Auth ------------------------------------------------------------------
# Generate each of these with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SESSION_SECRET=change-me-too

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth ----------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Authorised redirect URI must exactly match OAUTH_REDIRECT_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback

# --- Cookies ---------------------------------------------------------------
# Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
